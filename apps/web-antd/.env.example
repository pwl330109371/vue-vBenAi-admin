# 复制为 .env / .env.development / .env.production 并按环境修改

# 应用标题
VITE_APP_TITLE='悦签宝'

# 应用命名空间（缓存、Store 隔离前缀）
VITE_APP_NAMESPACE=vben-web-antd

# Store 持久化加密密钥（生产环境务必更换为随机强密钥）
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 开发端口
VITE_PORT=5666

VITE_BASE=/

# API 基址：开发可用 /api 走 Vite 代理
VITE_GLOB_API_URL=/api
VITE_GLOB_USER_CENTER_API_URL=/user-center
VITE_GLOB_USER_CENTER_SYSTEM_ID=93
VITE_GLOB_USER_CENTER_CHANNEL=web
VITE_GLOB_USER_CENTER_LOGIN_AES_KEY=GViX2lkr7oQNS9tK
VITE_GLOB_FEISHU_OPEN_API_URL=/open-apis
VITE_GLOB_FEISHU_APP_ID=
VITE_GLOB_FEISHU_APP_SECRET=
VITE_GLOB_FEISHU_REDIRECT_URL=http://localhost:5666/lark-redirect

# 仅开发代理使用，生产环境请改为网关或完整地址
VITE_PROXY_USER_CENTER_TARGET=
VITE_PROXY_FEISHU_TARGET=https://open.feishu.cn

# 开发期 Mock（生产必须为 false）
VITE_NITRO_MOCK=true

VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true
