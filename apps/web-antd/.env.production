VITE_BASE=/

# 生产环境 API 地址（请替换为真实网关）
VITE_GLOB_API_URL=https://your-api.example.com/api

# 生产环境必须关闭 Mock
VITE_NITRO_MOCK=false

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
